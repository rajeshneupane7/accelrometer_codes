",
    "    corr = df[feats].corr()
",
    "    mask = np.triu(np.ones_like(corr, dtype=bool))
",
    "    plt.figure(figsize=(12, 10))
",
    "    sns.heatmap(corr, mask=mask, cmap="coolwarm", vmax=.3, center=0,
",
    "                square=True, linewidths=.5, cbar_kws={"shrink": .5})
",
    "    plt.title("Feature Correlation Matrix")
